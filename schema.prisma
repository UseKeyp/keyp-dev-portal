
model StudiosOnDevelopers {
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  developer   Developer         @relation(fields: [developerId], references: [id])
  studio      Studio            @relation(fields: [studioId], references: [id])
  developerId String
  studioId    String
  accessLevel StudioPermissions

  @@id([developerId, studioId])
}

model Studio {
  id         String                @id
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  collection Collection[]
  developers StudiosOnDevelopers[]
  Transfer   Transfer[]
}

model Developer {
  id        String                @id
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  studios   StudiosOnDevelopers[]
}

enum StudioPermissions {
  OWNER
  ADMIN
  MEMBER
}

model Collection {
  id                      String         @id // Contract address
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  type                    CollectionType
  studio                  Studio         @relation(fields: [studioId], references: [id])
  studioId                String
  facilitatorAccess       Boolean
  externalTransferEnabled Boolean
  deploymentTransaction   Transaction?   @relation(fields: [deploymentTransactionId], references: [id]) // Null if contract added manually
  deploymentTransactionId String?
  Transfer                Transfer[]
}

enum CollectionType {
  ERC1155
  ERC721
  ERC20
}
